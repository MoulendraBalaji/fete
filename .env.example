# ─────────────────────────────────────────────────────────────────────────────
# Fête — environment configuration
#
# Copy this file to `.env.local` for local development, or set the same
# variables in the Vercel dashboard (Project → Settings → Environment Variables)
# for a deployment. `.env.local` is git-ignored; never commit a real key.
#
# The app is fully functional with AI disabled: every AI feature has a
# deterministic fallback, so you can deploy with this whole block empty and
# still exercise budgets, timelines, rosters and the ledger.
# ─────────────────────────────────────────────────────────────────────────────

# Any provider that speaks the OpenAI-compatible `/chat/completions` shape:
# OpenAI, Google Gemini (compatibility endpoint), Groq, OpenRouter, Together,
# DeepSeek, Mistral, Fireworks, or a local llama.cpp / Ollama / vLLM server.
#
# These three are all-or-nothing: supplying only some of them leaves AI
# disabled and `/api/health` reports exactly which variables are missing.

# Base URL *including* the version segment, no trailing slash.
#   OpenAI ................ https://api.openai.com/v1
#   Google Gemini ......... https://generativelanguage.googleapis.com/v1beta/openai
#   Groq .................. https://api.groq.com/openai/v1
#   OpenRouter ............ https://openrouter.ai/api/v1
#   Together .............. https://api.together.xyz/v1
#   Ollama (local) ........ http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# The provider's API key. Server-side only — it is never sent to the browser,
# never included in a build, and never logged.
LLM_API_KEY=

# Model identifier as the provider names it. Small, fast models are the right
# choice here: every call is a short structured-extraction task, and all output
# is validated against a zod schema with a deterministic fallback on failure.
#   OpenAI ................ gpt-4o-mini
#   Google Gemini ......... gemini-2.0-flash
#   Groq .................. llama-3.3-70b-versatile
#   OpenRouter (free) ..... meta-llama/llama-3.3-70b-instruct:free
LLM_MODEL=gpt-4o-mini

# Per-IP request ceiling per minute, shared across all four AI routes.
# Deliberately conservative because free provider tiers have tight quotas.
# Range 1–600. Default 15.
RATE_LIMIT_PER_MIN=15
